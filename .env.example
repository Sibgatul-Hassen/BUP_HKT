# Copy to .env and fill in. NEVER commit the real .env
# Any OpenAI-compatible chat-completions provider works.

# --- Google Gemini (OpenAI-compatible endpoint) ---
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_MODEL=gemini-3.5-flash-lite
LLM_FALLBACK_MODELS=gemini-3.1-flash-lite
LLM_API_KEY=your_key_here

# --- Groq ---
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=llama-3.3-70b-versatile

# --- Cerebras ---
# LLM_BASE_URL=https://api.cerebras.ai/v1
# LLM_MODEL=llama-3.3-70b

# --- OpenRouter ---
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_MODEL=google/gemini-2.0-flash-exp:free

# Optional: comma-separated backup models tried when the primary is
# rate-limited or slow (e.g. shared free tiers on OpenRouter).
# (set above for Gemini; for OpenRouter free tiers list other :free models)

LLM_TIMEOUT_SECONDS=8
LLM_TOTAL_BUDGET_SECONDS=20
PORT=8000
